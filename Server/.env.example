# Server Production & Development Environment Variables
PORT=4000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tractor_rental?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.fjmhgli.mongodb.net

# JWT Authentication Secret (use a long random 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_tractor_rental_2026

# Seeded Super Admin Credentials (will be automatically created if not existing)
ADMIN_EMAIL=admin@tractorrental.com
ADMIN_PASSWORD=AdminSecurePassword123!

# ImageKit Cloud Storage (Free tier: https://imagekit.io)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Allowed Frontend URL(s) for CORS (comma-separated, .vercel.app is allowed by default)
CLIENT_URL=https://your-tractor-rental-client.vercel.app
