# Production-safe environment template
# Copy this to Server/.env and replace the placeholder values with your real secrets.
PORT=4000
JWT_SECRET=replace_with_secure_random_string
MONGODB_URI=mongodb://localhost:27017/tractor-rental
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
